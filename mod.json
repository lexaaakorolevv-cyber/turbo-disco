{
    "geode": "5.11.1",
    "gd": {
        "win": "2.2081",
        "android": "2.2081"
    },
    "id": "local.routefinder",
    "name": "Route Finder",
    "version": "v1.10.0",
    "developer": "Route Finder contributors",
    "description": "Pause-only controls, best-percent HUD, calibrated route-chain search and verified solo/two-player physics-tick macros.",
    "settings": {
        "max-attempts": {
            "type": "int",
            "name": "Attempt limit (includes verification)",
            "default": 10000,
            "min": 2,
            "max": 100000
        },
        "max-seconds": {
            "type": "int",
            "name": "Wall time limit (seconds)",
            "default": 3600,
            "min": 10,
            "max": 86400
        },
        "max-attempt-seconds": {
            "type": "int",
            "name": "Per-attempt simulation limit (seconds)",
            "default": 600,
            "min": 10,
            "max": 1800
        },
        "mutation-window": {
            "type": "int",
            "name": "Mutation window (physics ticks)",
            "default": 120,
            "min": 8,
            "max": 2400
        },
        "search-seed": {
            "type": "int",
            "name": "Search seed",
            "default": 1337,
            "min": 1,
            "max": 2147483647
        },
        "auto-resume": {
            "type": "bool",
            "name": "Resume saved search",
            "description": "Find route restores this level search session when compatible. Disable to start a fresh search. Every attempt still starts from the beginning.",
            "default": true
        },
        "smooth-search": {
            "type": "bool",
            "name": "Lower search load",
            "description": "Lower: 6000 candidates and a cooperative 3 ms planning target per render frame. Normal: 12000 / 6 ms. Recording and replay keep every native physics tick.",
            "default": true
        }
    }
}
